# Public URL of the app (used for metadata and auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Supabase (public values; the service_role key must never be put here)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Google sign-in: set to "true" only after the provider is enabled in Supabase (see docs/AUTH.md)
NEXT_PUBLIC_AUTH_GOOGLE=false

# Chat: "false" limits the trainer chat to Premium plans (default: open to all signed-in members during pre-launch)
NEXT_PUBLIC_CHAT_OPEN_FOR_ALL=true

# Contact shown under the privacy policy and terms (required before store submission)
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional intro video for the first-launch screen (hosted mp4 URL). Empty = illustration slide.
NEXT_PUBLIC_INTRO_VIDEO_URL=
